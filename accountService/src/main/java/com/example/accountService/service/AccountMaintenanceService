import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;

@Service
public class AccountMaintenanceService {

    private final AccountRepository accountRepo;

    public AccountMaintenanceService(AccountRepository accountRepo) {
        this.accountRepo = accountRepo;
    }

    // Runs every hour (3600000 ms)
    @Scheduled(fixedRate = 3600000)
    @Transactional
    public void inactivateStaleAccounts() {
        LocalDateTime cutoff = LocalDateTime.now().minusHours(24);

        List<Accounts> staleAccounts = accountRepo.findStaleActiveAccounts(cutoff);

        for (Accounts acc : staleAccounts) {
            acc.setStatus(AccountStatus.INACTIVE);
        }

        accountRepo.saveAll(staleAccounts);

        System.out.println("✅ Inactivated " + staleAccounts.size() + " stale accounts at " + LocalDateTime.now());
    }
}
